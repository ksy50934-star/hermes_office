# Bibi Workspace cloud environment contract.
#
# Copy to .env.cloud for local work, and set the same names in the Vercel
# project. Never commit the filled-in file.
#
# The split below is the security boundary, not a style choice: Vite inlines
# every VITE_-prefixed value into the JavaScript it ships to the browser, so a
# privileged key named that way is published the moment the site builds.

# ---------------------------------------------------------------------------
# Browser (safe to publish — these ship inside the bundle)
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=https://CHANGE_ME.supabase.co
# The anon / publishable key only. A service-role key here is rejected at
# runtime and by `npm test`.
VITE_SUPABASE_ANON_KEY=CHANGE_ME_ANON_KEY

# ---------------------------------------------------------------------------
# Vercel serverless functions (never exposed to the browser)
# ---------------------------------------------------------------------------
SUPABASE_URL=https://CHANGE_ME.supabase.co
# Bypasses row level security. Set it in Vercel as a server environment
# variable and nowhere else.
SUPABASE_SERVICE_ROLE_KEY=CHANGE_ME_SERVICE_ROLE_KEY
# How long a connector may hold a work lease before it is reclaimed.
BIBI_LEASE_TTL_MS=300000
BIBI_MAX_LEASE_BATCH=4

# ---------------------------------------------------------------------------
# Local Mac connector (set on the Mac, not in Vercel)
# ---------------------------------------------------------------------------
# The only supported topology: the Mac dials out, nothing dials in.
BIBI_CONNECTOR_MODE=outbound-local-mac
BIBI_CONTROL_PLANE_URL=https://CHANGE_ME.vercel.app
BIBI_CONNECTOR_TOKEN=CHANGE_ME_CONNECTOR_TOKEN
BIBI_CONNECTOR_NODE_LABEL=local-mac
# Must stay empty. The connector opens no inbound port; any value here is a
# startup error.
BIBI_CONNECTOR_INBOUND_PORT=
# Installing the connector is not the same as authorising it to drive a real
# profile. Until this is true it polls, leases and reports, but runs dry.
BIBI_CONNECTOR_ALLOW_LOCAL_EXECUTION=false

# --- Hermes CLI execution --------------------------------------------------
# Hermes is driven as a subprocess, never over a network address. The verified
# invocation is:
#
#   hermes chat -q PROMPT -Q --source tool --max-turns N
#
# A profile is selected ONLY by the child process's HERMES_HOME. There is no
# profile flag. CEO비비 (organisational slot bibi-01) runs from the default home
# below; bibi-02..bibi-18 run from BIBI_HERMES_PROFILES_ROOT/<id>.
#
# ~/.hermes/profiles/bibi-01 is a rollback original and is never executed.
#
# These three are required whenever BIBI_CONNECTOR_ALLOW_LOCAL_EXECUTION=true;
# the connector refuses to start without them.
BIBI_HERMES_BIN=/usr/local/bin/hermes
BIBI_HERMES_DEFAULT_HOME=CHANGE_ME_ABSOLUTE_PATH_TO/.hermes
BIBI_HERMES_PROFILES_ROOT=CHANGE_ME_ABSOLUTE_PATH_TO/.hermes/profiles
# Caps on one run, so a stuck session cannot pin the Mac.
BIBI_HERMES_MAX_TURNS=12
BIBI_HERMES_TIMEOUT_MS=300000
BIBI_HERMES_MAX_OUTPUT_BYTES=2097152

# --- Connector polling -----------------------------------------------------
BIBI_CONNECTOR_POLL_INTERVAL_MS=5000
BIBI_CONNECTOR_HEARTBEAT_INTERVAL_MS=30000
BIBI_CONNECTOR_REQUEST_TIMEOUT_MS=20000
BIBI_CONNECTOR_MAX_BATCH=4
